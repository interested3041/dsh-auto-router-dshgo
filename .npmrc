# The @deepseek-ai/* runtime packages are provided by the DSH installation at
# runtime (the loader resolves them from the shipped app, not npm). Ambient type
# declarations in types/dsh.d.ts type-check against the installed 0.2.2 contract.
# Disable peer auto-install so `pnpm install` only fetches build-time tooling.
auto-install-peers=false
