{
  "name": "dsh-auto-router-dshgo",
  "version": "0.1.0",
  "description": "DeepSeek Harness 移动端(dshgo)多厂商智能路由插件:注册虚拟模型 bailian-auto,单 API key 下由决策模型按任务自动路由到最合适的执行模型;支持百炼/硅基流动/OpenRouter/火山方舟/智谱等单key多模型平台,内置额度感知、冷却回退、负载均衡与失败静默切换。Mobile (dshgo) port of dsh-auto-router: vendor-neutral decision-model router, one API key many models, quota-aware cooldown, load balancing and silent fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "types",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "scripts",
    "test",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshgo": ">=0.2.2-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke": "node test/smoke.mjs",
    "test": "node test/smoke.mjs && node test/classify.test.mjs && node test/router.test.mjs && node test/account.test.mjs && node test/accounts.test.mjs && node test/vendors.test.mjs && node test/behavior.test.mjs",
    "test:live": "node test/live.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.9.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "dshgo": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dshgo",
    "mobile",
    "client-plugin",
    "bailian",
    "dashscope",
    "aliyun",
    "siliconflow",
    "openrouter",
    "volcengine",
    "zhipu",
    "multi-vendor",
    "qwen",
    "router",
    "llm",
    "fallback"
  ],
  "author": "interested3041",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interested3041/dsh-auto-router-dshgo.git"
  },
  "homepage": "https://github.com/interested3041/dsh-auto-router-dshgo#readme",
  "bugs": {
    "url": "https://github.com/interested3041/dsh-auto-router-dshgo/issues"
  },
  "os": [
    "darwin",
    "linux",
    "win32",
    "android",
    "ios"
  ]
}
